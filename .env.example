# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <database> with your cluster credentials
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/salahtrack?retryWrites=true&w=majority"

# Telegram group bot
# 1. Create a bot with @BotFather → /newbot; /setjoingroups → Enable.
# Bot server only (bot/index.ts) — never put the token on Vercel or prefix it with NEXT_PUBLIC_
TELEGRAM_BOT_TOKEN="123456789:replace-with-your-bot-token"
