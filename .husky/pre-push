#!/usr/bin/env sh

echo "🚀 [pre-push] Commencing rigorous pre-push quality gate..."

# Step 1: Type Checking across the whole project
echo "🛡️  [pre-push] Step 1/3: Verifying TypeScript compilation (zero errors)..."
npm run typecheck

# Step 2: Automated Unit & Integration Tests
echo "🧪 [pre-push] Step 2/3: Running complete test suite..."
npm test

# Step 3: Production Build Verification
echo "🏗️  [pre-push] Step 3/3: Validating Next.js production build..."
npm run build

echo "🎉 [pre-push] All quality gates passed! Safe to push to remote repository."
