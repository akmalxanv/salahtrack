# SalahTrack Telegram bot (bot/index.ts) — standalone long-polling process.
# Build:  docker build -f Dockerfile.bot -t salahtrack-bot .
FROM node:24-slim

WORKDIR /app
ENV NODE_ENV=production

# Production deps only. --ignore-scripts skips husky's "prepare" (a dev tool);
# argon2 ships prebuilt binaries, so no compiler is needed.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY tsconfig.json ./
COPY src ./src
COPY bot ./bot

USER node
# Node 24 runs TypeScript directly by stripping types
CMD ["node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "bot/index.ts"]
